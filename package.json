{
  "name": "poop-games",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "vitest run tests && python3 -m unittest discover -s tests -p \"test_*.py\"",
    "typecheck": "tsc --noEmit",
    "puzzles": "node scripts/generate-puzzles.mjs",
    "build:ios": "npx eas-cli build -p ios --profile production",
    "submit:ios": "npx eas-cli submit -p ios --profile production"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/lora": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.118.0",
    "expo": "~57.0.24",
    "expo-apple-authentication": "~57.0.2",
    "expo-asset": "~57.0.20",
    "expo-crypto": "~57.0.4",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "open-crossword-bank": "1.0.2",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  }
}
